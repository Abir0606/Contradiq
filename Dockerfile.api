FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -e . --group dev 2>/dev/null || pip install --no-cache-dir -e . && pip install --no-cache-dir fastapi "uvicorn[standard]" streamlit httpx
COPY . .
EXPOSE 8000
CMD ["uvicorn", "contractiq.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
