FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -e . && pip install --no-cache-dir streamlit httpx
COPY src/contractiq/ui ./src/contractiq/ui
EXPOSE 8501
ENV CONTRACTIQ_API_URL=http://api:8000
CMD ["streamlit", "run", "src/contractiq/ui/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
